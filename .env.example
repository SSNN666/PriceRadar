# ===== 真价雷达 PriceRadar · 环境变量模板 =====
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore，不会进版本库）
# 注册指引：docs/accounts-onboarding.md

# 京东联盟（union.jd.com）—— 商品 / 公开券 / 信号字段（好评率、销量、自营标识）
JD_UNION_APP_KEY=
JD_UNION_APP_SECRET=
JD_UNION_SITE_ID=          # 推广位 PID
JD_UNION_MEDIA_ID=         # 导购媒体 ID
JD_UNION_UNION_ID=         # 联盟 ID（溯源用，可选）

# 拼多多开放平台 + 多多进宝 —— 商品 / 公开券 / 销量（sales_tip）
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# 博查搜索 API —— L2 风险检索（PRD §5.8），新用户 1000 次免费
BOCHA_API_KEY=

# 以下为 M1 阶段使用（识图 / 报告生成）
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=           # 可选：覆盖对话模型名（默认 deepseek-chat）
#                           # ⚠️ deepseek-chat 仍可用但已不在 /models 列表里（2026-10-10 实测）
#                           # 换模型须重测 prompt 缓存命中率并重录 agent_eval，见 llm.py 注释
# DASHSCOPE_API_KEY=        # Qwen-VL 识图（阿里云百炼）
# DASHSCOPE_VL_MODEL=       # 可选：覆盖视觉模型名（默认 qwen3-vl-plus）
#                           # DashScope 会下架旧模型名导致 404 model_not_found；
#                           # 换代时改这里即可，不必改代码。可用列表：
#                           # curl -H "Authorization: Bearer $DASHSCOPE_API_KEY" \
#                           #   https://dashscope.aliyuncs.com/compatible-mode/v1/models
